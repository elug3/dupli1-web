DUPLI1_API_BASE_URL=http://localhost:8080

# Service account for server-side customer registration (BFF → POST /api/v1/auth/register).
# Service accounts have no password: the BFF exchanges this API key at
# POST /api/v1/auth/token on the gateway's internal listener. It must match
# DUPLI1_WEB_SERVICE_API_KEY on dupli1-auth (this is the local Compose dev key).
DUPLI1_WEB_SERVICE_API_KEY=dk_test_local-dev-web-service-key-not-a-secretxxxxx
DUPLI1_WEB_SERVICE_AUTH_URL=http://localhost:8091
# Optional short-lived access-token override (skips the key exchange when set):
# DUPLI1_WEB_SERVICE_TOKEN=your-service-account-access-token

# Optional: trust a PEM CA / self-signed gateway cert when DUPLI1_API_BASE_URL is https://
# (local Compose after scripts/dupli1-local-tls/apply.sh). Not needed for plain HTTP.
# DUPLI1_API_CA_FILE=../dupli1/certs/server.crt

# Optional overrides for split-service deployments:
# DUPLI1_AUTH_API_BASE_URL=http://localhost:8080
# DUPLI1_PRODUCT_API_BASE_URL=http://localhost:8081
# Cart service (gateway path /api/v1/cart*; Compose cart listens on :8086)
# DUPLI1_CART_API_BASE_URL=http://localhost:8080
# DUPLI1_ORDER_API_BASE_URL=http://localhost:8080
# DUPLI1_PAYMENT_API_BASE_URL=http://localhost:8080
